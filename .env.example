# ==========================================
# GitHub OAuth Configuration for Decap CMS
# ==========================================
# Create a GitHub OAuth App at:
# https://github.com/settings/developers -> "OAuth Apps" -> "New OAuth App"
#
# Homepage URL:
#   https://your-vercel-domain.vercel.app (or http://localhost:3000 for local testing)
# Authorization callback URL:
#   https://your-vercel-domain.vercel.app/api/callback
#
# Once created, copy the Client ID and Client Secret below:
OAUTH_GITHUB_CLIENT_ID=your_github_oauth_client_id_here
OAUTH_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
